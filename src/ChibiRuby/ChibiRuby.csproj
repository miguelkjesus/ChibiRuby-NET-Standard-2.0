<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>13</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ChibiRuby.Tests" />
        <InternalsVisibleTo Include="ChibiRuby.Serializer" />
        <InternalsVisibleTo Include="SampleConsoleApp" />
        <InternalsVisibleTo Include="ChibiRuby.Debugger" />
        <InternalsVisibleTo Include="ChibiRuby.Debugger.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Utf8StringInterpolation" Version="1.3.2" />
    </ItemGroup>



    <ItemGroup>
      <ProjectReference Include="..\ChibiRuby.SourceGenerator\ChibiRuby.SourceGenerator.csproj">
          <OutputItemType>Analyzer</OutputItemType>
          <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      </ProjectReference>
    </ItemGroup>

    <PropertyGroup>
        <ChibiRubyGenerator_RbsOutputDirectory>$(MSBuildProjectDirectory)/../../sig</ChibiRubyGenerator_RbsOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="ChibiRubyGenerator_RbsOutputDirectory" />
    </ItemGroup>

    <ItemGroup>
        <None Include="StdLib\**\*.mrb">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="StdLib\lib.rbs" />
    </ItemGroup>

    <Import Project="..\Polyfills.props" />
    <ItemGroup>
        <ProjectReference Include="..\ChibiRuby.Polyfills\ChibiRuby.Polyfills.csproj" />
    </ItemGroup>
</Project>
